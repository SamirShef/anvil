use std::collections::HashMap;

#[derive(Debug, Clone, Copy)]
pub struct InstId(pub usize);
#[derive(Debug, Clone, Copy)]
pub struct BasicBlockId(pub usize);
#[derive(Debug, Clone, Copy)]
pub struct FunctionId(pub usize);

pub enum Inst {
    Binary(InstId, InstId),
    Call(FunctionId),
    Jump(BasicBlockId),
    JumpIf(InstId, BasicBlockId, BasicBlockId),
    Alloca,
    Load(InstId),
    Store(InstId),
}

pub struct BasicBlock {
    pub body: Vec<Inst>,
}

impl BasicBlock {
    pub fn new() -> Self {
        Self { body: Vec::new() }
    }
}

pub struct Function {
    pub body: Vec<BasicBlock>,
}

impl Function {
    pub fn new() -> Self {
        Self { body: Vec::new() }
    }
}

pub enum NameVariant {
    Name(String),
    Id(usize),
}

pub struct Context {
    funcs: Vec<Function>,
    cur_func: Option<FunctionId>,

    inst_names: HashMap<InstId, NameVariant>,
    bb_names: HashMap<BasicBlockId, NameVariant>,
    func_names: HashMap<FunctionId, NameVariant>,
}

impl Context {
    pub fn new() -> Self {
        Self {
            funcs: Vec::new(),
            cur_func: None,
            inst_names: HashMap::new(),
            bb_names: HashMap::new(),
            func_names: HashMap::new(),
        }
    }

    pub fn create_bb_with_name(&mut self, name: String) -> Option<BasicBlockId> {
        if self.cur_func.is_none() {
            return None;
        }

        let idx = self.cur_func.unwrap().0;
        let id = BasicBlockId(self.funcs[idx].body.len());

        Some(id)
    }
}
